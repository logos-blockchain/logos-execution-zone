# Every variable docker-compose.yml reads, at its default. Copy to `.env` (read automatically) or
# pass with `docker compose --env-file`, and change what differs.

# Images
LEZ_SEQUENCER_IMAGE=lez/sequencer_service:mdns
LEZ_INDEXER_IMAGE=lez/indexer_service
LEZ_EXPLORER_IMAGE=lez/explorer_service

# Bedrock.
BEDROCK_PORT=18080
LEZ_BEDROCK_URL=http://logos-blockchain-node-0:18080
# Pays the sequencers' inscriptions; the dev Bedrock node's funded key.
LEZ_FUNDING_PUBLIC_KEY=2e03b2eff5a45478e7e79668d2a146cf2c5c7925bce927f2b1c67f2ab4fc0d26

# Sequencers: one shared config, and a channel signing key and host ports per node.
LEZ_SEQUENCER_CONFIG_FILE=./lez/configs/docker-all-in-one/devnet/sequencer_config.json
## 0 ##
LEZ_SEQ_0_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-0/channel_signing_key
LEZ_SEQ_0_RPC_PORT=3040
LEZ_SEQ_0_METRICS_PORT=9000
## 1 ##
LEZ_SEQ_1_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-1/channel_signing_key
LEZ_SEQ_1_RPC_PORT=3041
LEZ_SEQ_1_METRICS_PORT=9001
## 2 ##
LEZ_SEQ_2_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-2/channel_signing_key
LEZ_SEQ_2_RPC_PORT=3042
LEZ_SEQ_2_METRICS_PORT=9002
## 3 ##
LEZ_SEQ_3_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-3/channel_signing_key
LEZ_SEQ_3_RPC_PORT=3043
LEZ_SEQ_3_METRICS_PORT=9003

# Indexer and explorer.
LEZ_INDEXER_CONFIG_FILE=./lez/configs/docker-all-in-one/indexer_config.json
LEZ_INDEXER_RPC_PORT=8779
LEZ_EXPLORER_PORT=8080

# Monitoring, with `--profile monitoring`.
LEZ_PROMETHEUS_PORT=9090
LEZ_GRAFANA_PORT=3000
