# Every variable docker-compose.yml reads, at its default. Copy to `.env` (read automatically) or
# pass with `docker compose --env-file`, and change what differs.

# Images
LEZ_COMPOSE_SEQUENCER_IMAGE=lez/sequencer_service:mdns
LEZ_COMPOSE_INDEXER_IMAGE=lez/indexer_service:latest
LEZ_COMPOSE_EXPLORER_IMAGE=lez/explorer_service:latest

# Bedrock.
# Host port Bedrock is published on, for tools outside Docker.
LEZ_COMPOSE_BEDROCK_PORT=18080
# Where the sequencer containers reach Bedrock;
# Bedrock's in-network port, unaffected by LEZ_COMPOSE_BEDROCK_PORT.
#
# NOTE: The indexer's Bedrock address is in its config file, see LEZ_COMPOSE_INDEXER_CONFIG_FILE.
# We won't need to care about indexer after sequencer-indexer merge is complete.
LEZ_COMPOSE_SEQUENCER_BEDROCK_NODE_URL=http://logos-blockchain-node-0:18080
# Pays the sequencers' inscriptions; the dev Bedrock node's funded key.
LEZ_COMPOSE_FUNDING_PUBLIC_KEY=2e03b2eff5a45478e7e79668d2a146cf2c5c7925bce927f2b1c67f2ab4fc0d26

# Sequencers: one shared config, and a channel signing key and host ports per node.
LEZ_COMPOSE_SEQUENCER_CONFIG_FILE=./lez/configs/docker-all-in-one/devnet/sequencer_config.json
## 0 ##
LEZ_COMPOSE_SEQ_0_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-0/channel_signing_key
LEZ_COMPOSE_SEQ_0_RPC_PORT=3040
LEZ_COMPOSE_SEQ_0_METRICS_PORT=9000
## 1 ##
LEZ_COMPOSE_SEQ_1_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-1/channel_signing_key
LEZ_COMPOSE_SEQ_1_RPC_PORT=3041
LEZ_COMPOSE_SEQ_1_METRICS_PORT=9001
## 2 ##
LEZ_COMPOSE_SEQ_2_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-2/channel_signing_key
LEZ_COMPOSE_SEQ_2_RPC_PORT=3042
LEZ_COMPOSE_SEQ_2_METRICS_PORT=9002
## 3 ##
LEZ_COMPOSE_SEQ_3_KEY_FILE=./lez/configs/docker-all-in-one/devnet/seq-3/channel_signing_key
LEZ_COMPOSE_SEQ_3_RPC_PORT=3043
LEZ_COMPOSE_SEQ_3_METRICS_PORT=9003

# Indexer and explorer.
LEZ_COMPOSE_INDEXER_CONFIG_FILE=./lez/configs/docker-all-in-one/indexer_config.json
LEZ_COMPOSE_INDEXER_RPC_PORT=8779
LEZ_COMPOSE_EXPLORER_PORT=8080
# Where the explorer container reaches the indexer.
LEZ_COMPOSE_EXPLORER_INDEXER_URL=http://indexer_service:8779

# Monitoring, with `--profile monitoring`.
LEZ_COMPOSE_PROMETHEUS_PORT=9090
LEZ_COMPOSE_GRAFANA_PORT=3000
