      "id": 16,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [ "last", "max" ] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(cross_zone_dispatches_retired_total{sequencer=\"$sequencer\"}[$__rate_interval]) * 60",
          "legendFormat": "given up on",
          "refId": "A"
        }
      ],
