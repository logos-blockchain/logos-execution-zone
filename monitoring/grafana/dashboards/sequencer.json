          "legendFormat": "${percentile:text}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(transactions_per_block_sum{sequencer=\"$sequencer\"}[$__rate_interval]) / rate(transactions_per_block_count{sequencer=\"$sequencer\"}[$__rate_interval])",
          "legendFormat": "avg",
          "refId": "B"
        }
      ],
      "title": "Transactions per block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0.0,
          "max": 100.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70.0 },
              { "color": "red", "value": 90.0 }
            ]
          }
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 30 },
      "id": 10,
      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * mempool_size{sequencer=\"$sequencer\"} / mempool_max_size{sequencer=\"$sequencer\"}",
          "legendFormat": "utilization",
          "refId": "A"
        }
      ],
      "title": "Mempool utilization",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
