{
  "annotations": { "list": [ ] },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [ "sequencer" ],
      "title": "Sequencer dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short", "decimals": 0 },
        "overrides": [ ]
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "chain_height{sequencer=\"$sequencer\"}",
          "legendFormat": "height",
          "refId": "A"
        }
      ],
      "title": "Chain height",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Counted once finalized: until then a conflict can orphan a block.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short", "decimals": 0 },
        "overrides": [ ]
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "blocks_produced_total{sequencer=\"$sequencer\"}",
          "legendFormat": "produced",
          "refId": "A"
        }
      ],
      "title": "Blocks produced by this sequencer since startup",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }, "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "produced · blocks/min" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [ "last", "max" ] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(blocks_produced_total{sequencer=\"$sequencer\"}[$__rate_interval]) * 60",
          "legendFormat": "produced · blocks/min",
          "refId": "A"
        }
      ],
      "title": "Block production rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 70 },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "transparent", "index": 0, "text": "waiting" },
                "1": { "color": "blue", "index": 1, "text": "writing" }
              }
            }
          ]
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 7 },
      "id": 4,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [ ] },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "turn_to_write{sequencer=\"$sequencer\"}",
          "legendFormat": "turn",
          "refId": "A"
        }
      ],
      "title": "Turn to write",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short", "decimals": 0 },
        "overrides": [ ]
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 7 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "turns_to_write_total{sequencer=\"$sequencer\"}",
          "legendFormat": "turns",
          "refId": "A"
        }
      ],
      "title": "Turns to write since startup",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 3.0 }
            ]
          }
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 7 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "production_failed_attempts{sequencer=\"$sequencer\"}",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "title": "Failed production turns in a row",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }, "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [ 8, 4 ], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "last", "max" ] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(${percentile}, sum by (le) (rate(block_creation_time_seconds_bucket{sequencer=\"$sequencer\"}[$__rate_interval])))",
          "legendFormat": "${percentile:text}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(block_creation_time_seconds_sum{sequencer=\"$sequencer\"}[$__rate_interval]) / rate(block_creation_time_seconds_count{sequencer=\"$sequencer\"}[$__rate_interval])",
          "legendFormat": "avg",
          "refId": "B"
        }
      ],
      "title": "Block creation time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }, "unit": "s" },
        "overrides": [ ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "last", "max" ] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(${percentile}, sum by (le, kind, origin, status) (rate(mempool_transaction_application_time_seconds_bucket{sequencer=\"$sequencer\"}[$__rate_interval])))",
          "legendFormat": "{{kind}} · {{origin}} · {{status}}",
          "refId": "A"
        }
      ],
      "title": "Transaction application time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }, "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [ 8, 4 ], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [ "last", "max" ] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
