    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Sent: queued into the mailbox. Handled: taken off it. Sent staying above handled grows the backlog.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "unit": "short",
          "min": 0.0
        },
