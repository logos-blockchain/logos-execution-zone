      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "Infinity": { "color": "text", "index": 0, "text": "unbounded" } } }
