      "options": {
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(kameo_messages_sent_total{sequencer=\"$sequencer\", actor_name=~\"(?:[a-z0-9_]+::)*$actor(?:<.*)?\"}) - sum(kameo_messages_received_total{sequencer=\"$sequencer\", actor_name=~\"(?:[a-z0-9_]+::)*$actor(?:<.*)?\"})) / (sum(actor_mailbox_capacity{sequencer=\"$sequencer\", actor_name=~\"(?:[a-z0-9_]+::)*$actor(?:<.*)?\"}) < +Inf)",
          "legendFormat": "fill",
          "refId": "A"
        }
      ],
      "title": "${actor} · mailbox fill",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Messages sent to the actor and not yet taken off its mailbox.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
