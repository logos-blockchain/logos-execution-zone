        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kameo_link_died_received_total{sequencer=\"$sequencer\", actor_name=~\"(?:[a-z0-9_]+::)*$actor(?:<.*)?\"})",
          "legendFormat": "linked actor deaths",
          "refId": "B"
        }
      ],
      "title": "${actor} · lifecycle and link signals since startup",
      "type": "timeseries"
    }
