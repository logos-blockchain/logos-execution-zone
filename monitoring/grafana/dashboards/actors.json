      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(actor_mailbox_capacity{sequencer=\"$sequencer\", actor_name=~\"(?:[a-z0-9_]+::)*$actor(?:<.*)?\"})",
          "legendFormat": "capacity",
          "refId": "A"
        }
      ],
      "title": "${actor} · mailbox capacity",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backlog as a share of the mailbox capacity: at 100%, senders wait. An unbounded mailbox never fills, so it has no fill.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0.0,
          "max": 100.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50.0 },
              { "color": "red", "value": 90.0 }
            ]
          }
        },
        "overrides": [ ]
