      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_replace(sum by (actor_name) (kameo_messages_sent_total{sequencer=\"$sequencer\"}), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\") - label_replace(sum by (actor_name) (kameo_messages_received_total{sequencer=\"$sequencer\"}), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\")",
