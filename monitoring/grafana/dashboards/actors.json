    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Running, stopped, restarting by its supervisor, or failed by a panic or error; empty while the actor does not exist, e.g. the sequencer is down. A state shorter than a scrape may not show; restarts are counted under Restarts.",
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 70 },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "text", "index": 0, "text": "stopped" },
                "1": { "color": "green", "index": 1, "text": "running" },
                "2": { "color": "orange", "index": 2, "text": "restarting" },
                "3": { "color": "red", "index": 3, "text": "failed" }
              }
            }
          ],
          "links": [
            {
              "title": "Show this actor",
              "url": "/d/sequencer-actors?var-sequencer=${sequencer}&var-actor=${__field.labels.actor}&${__url_time_range}"
