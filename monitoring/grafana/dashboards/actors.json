{
  "annotations": { "list": [ ] },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [ "sequencer" ],
      "title": "Dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "decimals": 0,
          "min": 0.0,
          "links": [
            {
              "title": "Show this actor",
              "url": "/d/sequencer-actors?var-sequencer=${sequencer}&var-actor=${__field.labels.actor}&${__url_time_range}"
            }
          ]
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 36,
        "minVizWidth": 8,
        "namePlacement": "top",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(label_replace(sum by (actor_name) (increase(kameo_messages_received_total{sequencer=\"$sequencer\"}[$__range])), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\"))",
          "instant": true,
          "legendFormat": "{{actor}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "All actors · messages handled over the time range",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "At the percentile picked above. From taking a message off the mailbox to its handler returning, awaits included. A handler that replies from a background task counts only until it hands the work off.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "s",
          "min": 0.0,
          "links": [
            {
              "title": "Show this actor",
              "url": "/d/sequencer-actors?var-sequencer=${sequencer}&var-actor=${__field.labels.actor}&${__url_time_range}"
            }
          ]
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 36,
        "minVizWidth": 8,
        "namePlacement": "top",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(label_replace(histogram_quantile(${percentile}, sum by (le, actor_name) (rate(actor_message_handling_time_seconds_bucket{sequencer=\"$sequencer\"}[$__range]))), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\"))",
          "instant": true,
          "legendFormat": "{{actor}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "All actors · handling time over the time range",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Backlog as a share of the mailbox capacity: at 100%, senders wait. An unbounded mailbox never fills, so it has no fill.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0.0,
          "max": 100.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50.0 },
              { "color": "red", "value": 90.0 }
            ]
          },
          "links": [
            {
              "title": "Show this actor",
              "url": "/d/sequencer-actors?var-sequencer=${sequencer}&var-actor=${__field.labels.actor}&${__url_time_range}"
            }
          ]
        },
        "overrides": [ ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 36,
        "minVizWidth": 8,
        "namePlacement": "top",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(max_over_time((100 * (label_replace(sum by (actor_name) (kameo_messages_sent_total{sequencer=\"$sequencer\"}), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\") - label_replace(sum by (actor_name) (kameo_messages_received_total{sequencer=\"$sequencer\"}), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\")) / (label_replace(sum by (actor_name) (actor_mailbox_capacity{sequencer=\"$sequencer\"}), \"actor\", \"$1\", \"actor_name\", \"(?:[a-z0-9_]+::)*([A-Za-z0-9_]+).*\") < +Inf))[$__range:]))",
          "instant": true,
          "legendFormat": "{{actor}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "All actors · fullest mailbox over the time range",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
