// Ships this compose project's container logs to Loki, and the traces services send it over
// OTLP to Tempo.
//
// Each stream is labelled `service_name` (the compose service), and a sequencer's also
// `sequencer` (`sequencer_service_0` → `sequencer_0`), matching Prometheus' label so a
// dashboard's Sequencer dropdown filters metrics and logs alike. Every line gets the
// `level` it was logged at.
//
// Our services log one JSON object per line (`LOG_FORMAT=json`): the message, the event's
// fields, the emitting module's `target`, the fields of the spans it ran in and, while it exports
// traces, the ids of its trace and span. Its `timestamp` becomes the entry's; its `level` and, for
// a sequencer's line, the `actor` it ran in become labels. The actor is its type name,
// `ExecutorActor`, as the actors dashboard names it. The ids become structured metadata,
// `trace_id` and `span_id`, which Grafana links to the trace in Tempo. Those are then cut from the
// line, which Grafana shows next to them anyway; `| json` reaches the rest. `target` stays in the
// line: with a hundred or so values it would multiply the streams as a label.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Only this stack: other compose projects (e.g. the Docker-backed tests' Bedrock nodes)
	// share the daemon.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = sys.env("LEZ_COMPOSE_ALLOY_PROJECT_NAME")
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "sequencer_service_(\\d+)"
		target_label  = "sequencer"
		replacement   = "sequencer_$1"
	}
}

loki.source.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.containers.output
	forward_to       = [loki.process.levels.receiver]
	refresh_interval = "5s"
}

loki.process "levels" {
	// Ours: `{"level":"INFO","message":…,"openTelemetry":{"spanId":…,"traceId":…},
	// "span":{"actor.name":"sequencer_executor_actor::actor::ExecutorActor<…>",…},
	// "target":"sequencer_core","timestamp":…,…the event's other fields}`.
	stage.json {
		expressions = {
			timestamp = "",
			level     = "",
			actor     = "span.\"actor.name\"",
			trace_id  = "openTelemetry.traceId",
			span_id   = "openTelemetry.spanId",
		}
	}

	stage.regex {
		source     = "actor"
		expression = "^(?:[a-z0-9_]+::)*(?P<actor>[A-Za-z0-9_]+)"
	}

	// Plain-text lines have none, and keep the time Docker read them at.
	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}

	// The Bedrock node colors its output for a terminal.
	stage.decolorize { }

	// Plain-text lines, `2026-10-30T22:34:53Z ERROR module: …` (the Bedrock node's, or ours
	// with `LOG_FORMAT=text`). JSON lines start with `{`, so it leaves them alone.
	stage.regex {
		expression = "^\\d\\S*\\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\\b"
	}

	stage.labels {
		values = {level = "", actor = ""}
	}

	stage.structured_metadata {
		values = {trace_id = "", span_id = ""}
	}

	// Values are JSON-escaped, so a quoted key can only be one of the line's own.
	stage.replace {
		expression = "(\"(?:timestamp|level)\":\"[^\"]*\",)"
		replace    = ""
	}

	// Last when the event has no fields but its message.
	stage.replace {
		expression = "(,\"timestamp\":\"[^\"]*\")\\}\\s*$"
		replace    = ""
	}

	stage.replace {
		expression = "(\"actor\\.name\":\"[^\"]*\",)"
		replace    = ""
	}

	stage.replace {
		expression = "(\"openTelemetry\":\\{[^}]*\\},)"
		replace    = ""
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

otelcol.receiver.otlp "services" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.transform.sequencer.input]
	}
}

// A sequencer puts its public key in every span's `sequencer`. As in Prometheus and the logs,
// the node's name, here its `service.instance.id`, takes its place, so the dashboards' Sequencer
// dropdown finds its traces too.
otelcol.processor.transform "sequencer" {
	error_mode = "ignore"

	trace_statements {
		context    = "span"
		statements = [
			`set(attributes["sequencer"], resource.attributes["service.instance.id"]) where resource.attributes["service.instance.id"] != nil`,
		]
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}
